def template_triggers(t_num):
    """ Get the triggers for a specific template
    """
    template = None
    tparam = None
    out_vals_all = []
    # Hoisted out of the per-segment loop: this only depends on t_num,
    # not on anything segment-specific, so there is no reason to repeat
    # the dict lookup every segment.
    if marg_grid_by_hash is not None:
        grid = marg_grid_by_hash.get(int(bank.table.template_hash[t_num]))
    else:
        grid = None
    for s_num, stilde in enumerate(segments):
        # Filter check checks the 'inj_filter_rejector' options to
        # determine whether
        # to filter this template/segment if injections are present.
        if not inj_filter_rejector.template_segment_checker(
                bank, t_num, stilde):
            continue
        if template is None:
            template_comps = bank.get(t_num, stilde.psd)
            num_comps = len([a for a in template_comps if a is not None])
            tparam = template_comps[0].params

        if opt.update_progress:
            update_progress((t_num + (s_num / float(len(segments))) ) / len(bank),
                            opt.update_progress, opt.update_progress_file)
        logging.info("Filtering template %d/%d segment %d/%d" %
                     (t_num + 1, len(bank), s_num + 1, len(segments)))

        sigmasq = 1.
        snrsq_full, norm, corrs, snrs, idx, snrv_full = \
           matched_filter.matched_filter_and_cluster(s_num,
                                                     sigmasq,
                                                     cluster_window,
                                                     epoch=stilde._epoch,
                                                     num_comps=num_comps)
        if not len(idx):
            continue
        if inj_filter_rejector.enabled:
            trig_times = (
                (idx + stilde.cumulative_index) /
                snrsq_full.sample_rate + opt.gps_start_time
            )
            inj_idxs = inj_filter_rejector.find_indices_in_injection_intervals(
                trig_times
            )
            idx = idx[inj_idxs]
            snrv_full = snrv_full[inj_idxs]

        out_vals = out_vals_ref.copy()

        # --- marg_lnl computed and thresholded FIRST, before the much
        # more expensive bank_chisq/chisq/sg_chisq calls below, so that
        # triggers cut by --marg-lnl-threshold never have chisq computed
        # for them at all. This only needs snr_comp_1..5 (cheap: just
        # indexing into the already-filtered snrs arrays) and the
        # already-cached raw harmonics/grid data -- nothing here depends
        # on bank_chisq/chisq/sg_chisq, so this reorder changes nothing
        # about what gets computed, only the order/whether it's skipped.
        for i, snr_comp in enumerate(snrs):
            if snr_comp is None:
                out_vals['snr_comp_{0}'.format(i + 1)] = numpy.zeros(len(snrv_full), dtype=complex64)
            else:
                out_vals['snr_comp_{0}'.format(i + 1)] = snr_comp[idx+stilde.analyze.start] * norm

        if grid is not None:
            segment_psd = numpy.asarray(stilde.psd.data)
            # Raw harmonics are no longer stored in the grid file at all
            # (they were >99% of its size for a full bank -- see
            # THA_MARG_INFO.md). They don't need to be: bank.get()
            # (called earlier in this loop for ordinary matched
            # filtering) already generated and cached them, once per
            # template, directly on the template object -- see
            # bank.py's get_whitened_normalized_comps, which sets
            # self.h1..h5 to the RAW (pre-whiten/pre-orthogonalize)
            # harmonics before building the whitened copies used for
            # filtering. We just read those already-computed arrays
            # back out here -- no new lalsimulation calls at all.
            #
            # For templates with num_comps < 5, bank.py leaves the
            # unused h4/h5 (etc.) as None -- matching exactly how
            # snr_comp_4/5 are already zero-filled above for the same
            # templates, we substitute zero arrays here too, rather
            # than crashing, since those harmonics were never generated
            # for this template in the first place.
            _raw_h = [bank.curr_tmp.h1, bank.curr_tmp.h2, bank.curr_tmp.h3,
                     bank.curr_tmp.h4, bank.curr_tmp.h5]
            kmin, kmax = grid['kmin'], grid['kmax']
            raws = []
            for h in _raw_h:
                arr = numpy.zeros(len(segment_psd), dtype=numpy.complex128)
                if h is not None:
                    arr[kmin:kmax] = h.data[kmin:kmax]
                raws.append(arr)
            if len(segment_psd) != len(raws[0]):
                raise ValueError(
                    "marginalized-grid-file frequency binning does not "
                    "match this segment's PSD (raw harmonics have {} "
                    "bins, segment has {}). The grid file's "
                    "--sample-rate/--delta-f must exactly match this "
                    "search's configuration; see THA_MARG_INFO.md.".format(
                        len(raws[0]), len(segment_psd)))
            marg_z = numpy.array([out_vals['snr_comp_{0}'.format(i + 1)]
                                  for i in range(5)])
            # Re-derives the actual (PSD-dependent) filters for THIS
            # segment's real, estimated PSD from the PSD-independent
            # cached grid data (A, B) plus the already-cached raw
            # harmonics -- cheap (5x5 linear algebra plus small matrix
            # products), zero new lalsimulation calls at all beyond
            # what bank.get() above already performed. See
            # THA_MARG_INFO.md.
            out_vals['marg_lnl'] = tha_marginalize.marginalize_for_psd(
                grid, raws, segment_psd, marg_z).astype(float32)
        else:
            out_vals['marg_lnl'] = numpy.full(len(snrv_full), numpy.nan,
                                              dtype=float32)

        if opt.marg_lnl_threshold is not None:
            # NaN (no marginalization grid coverage for this template --
            # see the else branch above) is treated as "not applicable"
            # and passes through unfiltered by this threshold, rather
            # than being dropped: NaN >= threshold is False in numpy, so
            # without this explicit check every trigger from every
            # ungridded template would be silently discarded the moment
            # this option is used.
            keep = (numpy.isnan(out_vals['marg_lnl'])
                    | (out_vals['marg_lnl'] >= opt.marg_lnl_threshold))
            if not numpy.all(keep):
                n_before = len(keep)
                idx = idx[keep]
                snrv_full = snrv_full[keep]
                for key in out_vals:
                    val = out_vals[key]
                    if val is not None and hasattr(val, '__len__') \
                            and len(val) == n_before:
                        out_vals[key] = val[keep]
                logging.info(
                    "marg_lnl threshold: kept %d/%d triggers before "
                    "computing chisq", int(numpy.sum(keep)), n_before)
            if len(idx) == 0:
                continue

        # --- everything below here is unchanged from the original,
        # just now operating on the (possibly much smaller)
        # post-marg_lnl-threshold idx/snrv_full.
        out_vals['bank_chisq'], out_vals['bank_chisq_dof'] = \
              bank_chisq.values(template_comps[0], stilde.psd, stilde,
                                snrv_full, norm,
                                idx+stilde.analyze.start)

        out_vals['chisq'], out_vals['chisq_dof'] = \
              power_chisq.values(corrs, snrs, snrv_full, norm, stilde.psd,
                                 idx+stilde.analyze.start, template_comps)

        out_vals['sg_chisq'] = sg_chisq.values(
            stilde / stilde.psd ** 0.5, template_comps[0],
            stilde.psd,
            snrv_full, norm,
            out_vals['chisq'],
            out_vals['chisq_dof'],
            idx+stilde.analyze.start
        )

        #out_vals['cont_chisq'], _ = \
        #      autochisq.values(snr_full, idx+stilde.analyze.start,
        #                       template_comps[0],
        #                       stilde.psd, norm, stilde=stilde,
        #                       low_frequency_cutoff=flow)

        out_vals['snr'] = snrv_full * norm

        idx += stilde.cumulative_index
        out_vals['time_index'] = idx

        out_vals['sigmasq'] = numpy.zeros(len(snrv_full), dtype=float32) + sigmasq
        if opt.psdvar_short_segment is not None:
            out_vals['psd_var_val'] = \
                        pycbc.psd.find_trigger_value(psd_var,
                                      out_vals['time_index'],
                                      opt.gps_start_time, opt.sample_rate)

        out_vals_all.append(copy.deepcopy(out_vals))
        #print(out_vals_all)
    return out_vals_all, tparam

with ctx:
    # The following FFTW specific options needed to wait until
    # we were inside the scheme context.

    # Import system wisdom.
    if opt.fftw_import_system_wisdom:
