"""
Program for concatenating output files from pycbc_banksim split over bank
files. It is assumed that input files have analysed the same set of injections.
Concatenation of injections is done separately.
"""

from os.path import isfile
import argparse
import logging
from numpy import *
import pycbc
import pycbc.version

__author__  = "Ian Harry <ian.harry@astro.cf.ac.uk>"
__program__ = "pycbc_banksim_combine_banks"

# Read command line options
_desc = __doc__[1:]
parser = argparse.ArgumentParser(description=_desc)

pycbc.add_common_pycbc_options(parser)
parser.add_argument("-I", "--input-files", nargs='+',
                    help="Explicit list of input files.")
parser.add_argument("-o", "--output-file", required=True,
                    help="Output file name")

options = parser.parse_args()

BASE_KEYS = [1, 2, 3, 4, 5, 'vary', 'vary_max2', 'vary_max3', 'vary_max4']
GRID_KEYS = ['grid_{}'.format(k) for k in BASE_KEYS]

# pycbc_banksim_tha writes 22 columns, or 40 if run with
# --marginalized-grid-file (9 grid-constrained fitting factors and their 9
# template indices appended at the end). Detect which from the first file.
ncol = len(open(options.input_files[0]).readline().split())
if ncol == 22:
    has_grid = False
elif ncol == 40:
    has_grid = True
else:
    raise ValueError("Unexpected number of columns ({}) in {}".format(
        ncol, options.input_files[0]))
ALL_KEYS = BASE_KEYS + (GRID_KEYS if has_grid else [])

# input: same layout as the banksim match file
fields_i = [('match_{}'.format(k), float64) for k in BASE_KEYS]
fields_i += [('bank', str_, 256)]
fields_i += [('bank_i_{}'.format(k), int32) for k in BASE_KEYS]
fields_i += [('sim', str_, 256), ('sim_i', int32), ('sigmasq', float64)]
if has_grid:
    fields_i += [('match_{}'.format(k), float64) for k in GRID_KEYS]
    fields_i += [('bank_i_{}'.format(k), int32) for k in GRID_KEYS]
dtypei = dtype(fields_i)

# output: original 30 columns unchanged, grid columns appended
def _out_fields(keys):
    return ([('match_{}'.format(k), float64) for k in keys] +
            [('bank_{}'.format(k), str_, 256) for k in keys] +
            [('bank_i_{}'.format(k), int32) for k in keys])
fields_o = _out_fields(BASE_KEYS)
fields_o += [('sim', str_, 256), ('sim_i', int32), ('sigmasq', float64)]
fmt = ['%5.5f'] * 9 + ['%s'] * 9 + ['%i'] * 9 + ['%s', '%i', '%5.5f']
if has_grid:
    fields_o += _out_fields(GRID_KEYS)
    fmt += ['%5.5f'] * 9 + ['%s'] * 9 + ['%i'] * 9
dtypeo = dtype(fields_o)

matches=[]
maxmatch = []
for fil in options.input_files:
    matches.append(loadtxt(fil, dtype=dtypei))

# It is possible for the input files to only contain a single injection
# if the user has split the injections many times.
if array(matches, dtype=dtypei)['match_1'].ndim == 1:
    raise ValueError("Not supporting this yet")
else:
    out_arr = zeros(len(matches[0]), dtype=dtypeo)
    for i in ALL_KEYS:
        indices = array(matches, dtype=dtypei)['match_{}'.format(i)].argmax(0)
        for p, q in enumerate(indices):
            mfmt = 'match_{}'.format(i)
            out_arr[p][mfmt] = matches[q][p][mfmt]
            bfmt = 'bank_{}'.format(i)
            out_arr[p][bfmt] = matches[q][p]['bank']
            bifmt = 'bank_i_{}'.format(i)
            out_arr[p][bifmt] = matches[q][p][bifmt]
            out_arr[p]['sim'] = matches[q][p]['sim']
            out_arr[p]['sim_i'] = matches[q][p]['sim_i']
            out_arr[p]['sigmasq'] = matches[q][p]['sigmasq']

savetxt(options.output_file, out_arr, fmt=tuple(fmt), delimiter=' ')