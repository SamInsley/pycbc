#!/usr/bin/env python
import logging
import numpy
import argparse
import matplotlib
import sys
matplotlib.use('Agg')
import pylab

import pycbc.results
from pycbc.io import (
    get_chisq_from_file_choice, chisq_choices, SingleDetTriggers, HFile
)

parser = argparse.ArgumentParser()
pycbc.add_common_pycbc_options(parser)
parser.add_argument('--trigger-file', help='Single ifo trigger file')
parser.add_argument('--veto-file',
                    help='Optional, file of veto segments to remove triggers')
parser.add_argument('--segment-name', default=None, type=str,
                    help='Optional, name of segment list to use for vetoes')
parser.add_argument('--min-snr', type=float,
                    help='Optional, Minimum SNR to plot')
parser.add_argument('--output-file')
parser.add_argument(
    '--newsnr-contours',
    nargs='*',
    help="List of newsnr values to draw contours at. Only valid for "
         "--chisq-choice traditional (which is default)"
)
parser.add_argument('--chisq-choice', choices=chisq_choices,
                    default='traditional',
                    help='Which chisquared to plot. Default=traditional')
parser.add_argument('--x-var', default='snr',
                    choices=['snr', 'marg_lnl'],
                    help="Which quantity to plot on the x-axis. 'snr' "
                    "(default): the ordinary matched-filter SNR. "
                    "'marg_lnl': the marginalized-likelihood-derived "
                    "SNR-equivalent sqrt(2*marg_lnl) (same conversion "
                    "ranking.marg_newsnr uses internally) -- requires "
                    "the trigger file to have a marg_lnl column (i.e. "
                    "the run used --marginalized-grid-file). Triggers "
                    "where the resulting value is NaN or <= 0 (e.g. no "
                    "marginalization grid coverage for that template) "
                    "are dropped, since a log-scale x-axis cannot show "
                    "them.")
args = parser.parse_args()

pycbc.init_logging(args.verbose, default_level=1)


if args.newsnr_contours is not None and not args.chisq_choice == 'traditional':
    parser.error(
        "Newsnr contours are being plotted assuming a traditional "
        "chisquared, but this is not being plotted! We are plotting %s" %
        args.chisq_choice
    )

args.newsnr_contours = \
    args.newsnr_contours if args.newsnr_contours is not None else []

# First - get the IFO from the file
with HFile(args.trigger_file, 'r') as f:
    ifo = tuple(f.keys())[0]
    n_triggers = f[ifo]['snr'].size
    if args.x_var == 'marg_lnl' and 'marg_lnl' not in f[ifo]:
        parser.error(
            "--x-var marg_lnl requires a 'marg_lnl' column in "
            "--trigger-file, but it is missing from {}. This file was "
            "likely produced by a run that didn't use "
            "--marginalized-grid-file (or predates it) -- either rerun "
            "with that option, or drop --x-var marg_lnl to fall back to "
            "plain SNR.".format(args.trigger_file)
        )

logging.info(
    "Plotting %s vs %s chisq for %s triggers",
    args.x_var,
    args.chisq_choice,
    ifo
)

if args.min_snr is not None:
    filter_rank = 'snr'
else:
    filter_rank = None
    if n_triggers > 1e7:
        logging.warning(
            "Getting %d triggers with no SNR cut - this will be expensive!",
            n_triggers
        )

trigs = SingleDetTriggers(
    args.trigger_file,
    ifo,
    veto_file=args.veto_file,
    segment_name=args.segment_name,
    filter_rank=filter_rank,
    filter_threshold=args.min_snr,
)

logging.info(
    "Reading %s and %s chisq for %d triggers",
    args.x_var,
    args.chisq_choice,
    trigs.mask_size
)
chisq = get_chisq_from_file_choice(trigs, args.chisq_choice)

_PRETTY_X_LABELS = {
    'snr': 'Signal-to-Noise Ratio',
    'marg_lnl': r'Marginalized-Likelihood SNR $\sqrt{2\,\ln\mathcal{L}_{\rm marg}}$',
}

if args.x_var == 'snr':
    snr = trigs.snr
else:  # 'marg_lnl'
    # sqrt(2*marg_lnl) is the same SNR-equivalent conversion
    # ranking.marg_newsnr uses internally -- marg_lnl is the raw
    # log-likelihood at the trigger's best-fit marginalization grid
    # point (theta_jn, alpha0, psi), so this puts it on the same
    # footing as an ordinary matched-filter SNR for this plot.
    #
    # marg_lnl has no @property on SingleDetTriggers (only a fixed set
    # of columns, e.g. snr/chisq/psd_var_val, get one), so it can't be
    # accessed as trigs.marg_lnl -- but get_column() is the same
    # mask-aware column reader every one of those properties delegates
    # to internally, and it works for any column name actually present
    # in the trigger file, so call it directly instead.
    marg_lnl = trigs.get_column('marg_lnl')
    with numpy.errstate(invalid='ignore'):
        snr = numpy.sqrt(2. * marg_lnl)

snr_label = _PRETTY_X_LABELS[args.x_var]

# Triggers where the chosen x-quantity is NaN (marg_lnl: no
# marginalization grid coverage for that template) or <= 0 can't be
# shown on a log-scale x-axis -- drop them rather than letting them
# silently corrupt chisq.min()/snr.min() (NaN propagates through
# those) or the hexbin call.
keep = numpy.isfinite(snr) & (snr > 0)
n_dropped = len(snr) - int(keep.sum())
if n_dropped:
    logging.info(
        "Dropping %d/%d triggers with non-finite or non-positive %s "
        "-- not representable on a log x-axis",
        n_dropped, len(snr), args.x_var
    )
snr = snr[keep]
chisq = chisq[keep]


def snr_from_chisq(chisq, newsnr, q=6.):
    snr = numpy.zeros(len(chisq)) + float(newsnr)
    ind = numpy.where(chisq > 1.)[0]
    snr[ind] = float(newsnr) / ( 0.5 * (1. + chisq[ind] ** (q/2.)) ) ** (-1./q)
    return snr

fig = pylab.figure(1)

r = numpy.logspace(numpy.log(chisq.min()), numpy.log(chisq.max()), 300)

for i, cval in enumerate(args.newsnr_contours):
    logging.info("Plotting newsnr %s contour", cval)
    snrv = snr_from_chisq(r, cval)
    pylab.plot(snrv, r, color='black', lw=0.5)
    if i == 0:
        label = "$\\hat{\\rho} = %s$" % cval
    else:
        label = "$%s$" % cval
    try:
        label_pos_idx = numpy.where(snrv > snr.max() * 0.8)[0][0]
    except IndexError:
        label_pos_idx = 0
    pylab.text(snrv[label_pos_idx], r[label_pos_idx], label, fontsize=6,
               horizontalalignment='center', verticalalignment='center',
               bbox=dict(facecolor='white', lw=0, pad=0, alpha=0.9))

pylab.hexbin(snr, chisq, gridsize=300, xscale='log', yscale='log', lw=0.04,
             mincnt=1, norm=matplotlib.colors.LogNorm())

ax = pylab.gca()
pylab.grid()   
ax.set_xscale('log')
cb = pylab.colorbar() 
pylab.xlim(snr.min(), snr.max() * 1.1)
pylab.ylim(chisq.min(), chisq.max() * 1.1)
cb.set_label('Trigger Density')
pylab.xlabel(snr_label)
pylab.ylabel('Reduced $\\chi^2$')

pycbc.results.save_fig_with_metadata(fig, args.output_file,
     title="%s :%s vs Reduced %s &chi;<sup>2</sup>" % (ifo, snr_label, args.chisq_choice),
     caption="Distribution of %s and %s &chi;&sup2; for single detector triggers: "
             "Black lines show contours of constant NewSNR." \
              % (snr_label, args.chisq_choice),
     cmd=' '.join(sys.argv),
     fig_kwds={'dpi':300})